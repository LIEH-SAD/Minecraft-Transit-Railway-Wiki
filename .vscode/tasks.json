{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "启动 HTTP 服务器",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}\\live-server.py",
                "8080",
                "${workspaceFolder}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^🌟 Live-reload server running",
                    "endsPattern": "^🌟 Live-reload server running"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}
